<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formulario de pedido - Florería</title>
<link rel="stylesheet" href="estilos.css">
</head>
<body>
<main class="contenedor">
  <div class="contenedor-logo">
  	<img src="logo.png" width="149" height"200">
    <div class="nombre-marca">UPRIT</div>
  </div>

  <h1>FORMULARIO DE CAPTURA DE DATOS</h1>
  <h2>NUEVO PEDIDO</h2>

  <form id="formPedido">
    <div class="formulario-columnas">
      <section class="cuadro-azul">
        <table>
          <tr>
            <td><label for="txtnombre">Nombre:</label></td>
            <td><input class="dato" type="text" id="txtnombre" name="nombre" required></td>
          </tr>
          <tr>
            <td><label for="apellidos">Apellidos:</label></td>
            <td><input class="dato" type="text" id="apellidos" name="apellidos" required></td>
          </tr>
          <tr>
            <td><label for="direccion">Dirección:</label></td>
            <td><input class="dato" type="text" id="direccion" name="direccion" required></td>
          </tr>
        </table>
      </section>

      <section class="cuadro-azul">
        <label for="tarjeta">Número de tarjeta de crédito:</label>
        <input class="dato" type="text" id="tarjeta" name="tarjeta"
               inputmode="numeric" maxlength="19" placeholder="Ingrese el número de tarjeta" required>
        <p><strong>Seleccione su banco:</strong></p>
        <div class="opciones-banco">
          <label><input type="radio" name="banco" value="BBVA" required> BBVA</label>
          <label><input type="radio" name="banco" value="BCP"> BCP</label>
          <label><input type="radio" name="banco" value="SCOTIABANK"> SCOTIABANK</label>
          <label><input type="radio" name="banco" value="Caja Arequqipa"> CAJA AREQUIPA</label>
        </div>
      </section>
    </div>
    <div class="contenedor-enviar">
      <input type="submit" value="REALIZAR PEDIDO">
    </div>
  </form>

  <footer class="pie">
    <p>Copyright 2026 - Derechos reservados Florería</p>
    <p>Práctica de HTML y CSS</p>
    <p>CURI ALCANTARA YIYE AARON</p>
    <p>CARRASCO MOLLE WILDER</p>
    <p>MORI GARCIA WILLY OTMAR</p>
    <p>HILDEBRANDO BARRUETA JESUS</p>
  </footer>
</main>
<script>
document.getElementById("formPedido").addEventListener("submit", function(event) {
  event.preventDefault();
  alert("Formulario validado. Este ejemplo es demostrativo: no procesa pagos reales.");
});
</script>
</body>
</html>
